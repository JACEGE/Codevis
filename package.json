{
  "name": "codevis",
  "version": "1.0.0-beta.4",
  "description": "Graph-based code intelligence for AI agent teams — embedded graph database, node-level locking, task waves, AST editing via MCP",
  "bin": {
    "codevis": "bin/codevis.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "bin/",
    "lib/",
    "server/",
    "scripts/graph_builder.js",
    "scripts/knowledge_markdown.cjs",
    "scripts/repair_seq.cjs",
    "scripts/kanban.js",
    "scripts/ladybug_schema.cjs",
    "scripts/extractors.cjs",
    "scripts/test-file.cjs",
    "scripts/predefined-queries.cjs",
    "scripts/runtime_profiler.js",
    "scripts/reset_user_events.js",
    "scripts/reset_component.js",
    "scripts/annotations/",
    "scripts/spec/",
    "scripts/diff/",
    "scripts/diagram/",
    "scripts/ros/",
    "scripts/diag/",
    "scripts/parser/",
    "scripts/impact/",
    "docs/*.md",
    "docs/screenshots/",
    "tools/mcp_server.ts",
    "tools/package.json",
    "tools/handlers/",
    "tools/lib/",
    "tools/channels/",
    "templates/",
    "frontend/dist/"
  ],
  "scripts": {
    "preinstall": "node lib/check-node.cjs",
    "update:codevis": "node scripts/graph_builder.js codevis_db",
    "update:project": "node scripts/graph_builder.js project_db",
    "update:codevis-smart": "node scripts/graph_builder.js codevis_db diff",
    "update:project-smart": "node scripts/graph_builder.js project_db diff",
    "mcp": "tsx tools/mcp_server.ts",
    "dev": "npm run dev:frontend",
    "bridge": "npm run dev:bridge",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:bridge": "node server/bridge.js",
    "brain-channel": "npx tsx tools/channels/codevis-brain/server.ts",
    "profile:project": "node scripts/runtime_profiler.js project_db",
    "profile:codevis": "node scripts/runtime_profiler.js codevis_db",
    "reset:project": "node scripts/reset_user_events.js project_db",
    "reset:codevis": "node scripts/reset_user_events.js codevis_db",
    "reset:project-force": "node scripts/reset_user_events.js project_db --force",
    "reset:codevis-force": "node scripts/reset_user_events.js codevis_db --force",
    "reset-component:project": "node scripts/reset_component.js project_db",
    "reset-component:codevis": "node scripts/reset_component.js codevis_db",
    "kanban": "node scripts/kanban.js",
    "kanban:watch": "node scripts/kanban.js --watch",
    "build:frontend": "npm ci --prefix frontend && npm --prefix frontend run build",
    "prepublishOnly": "npm run release:check",
    "audit:release": "node scripts/release/audit-repository.cjs",
    "audit:dependencies": "npm audit && npm --prefix frontend audit --omit=dev",
    "release:check": "npm run audit:release && npm run audit:dependencies && npm run typecheck && npm test && npm run build:frontend && npm run smoke",
    "screenshots:docs": "node scripts/capture-doc-screenshots.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "smoke": "node scripts/smoke/fresh-install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JACEGE/Codevis.git"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "code-graph",
    "knowledge-graph",
    "ladybug",
    "cypher",
    "agent-teams",
    "ast",
    "locking"
  ],
  "author": "JACEGE",
  "bugs": {
    "url": "https://github.com/JACEGE/Codevis/issues"
  },
  "homepage": "https://github.com/JACEGE/Codevis#readme",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.17.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasm": "^1.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "puppeteer": "^25.10.0",
    "terser": "^5.46.1",
    "yauzl": "^3.4.0"
  }
}
